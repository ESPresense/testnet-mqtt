# The broker to copy from. Use an account that can only read espresense/#.
SOURCE_HOST=
SOURCE_PORT=1883
SOURCE_TLS=false
SOURCE_USERNAME=
SOURCE_PASSWORD=

# Every Companion PR publishes a versioned image; the PR's "Deploy to Docker" job prints the tag.
COMPANION_IMAGE=espresense/espresense-companion:beta

# Limits for the Companion under test.
COMPANION_CPUS=4
COMPANION_MEMORY=2g

# UI_PORT=0 picks a free port; find it with: docker compose port ui 8267
UI_BIND=127.0.0.1
UI_PORT=0

# true writes every source message to the data volume (raw house ids, ~200 MB a day).
RECORD_TRAFFIC=false
